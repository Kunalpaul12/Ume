# EmailJS Configuration
# Get these from https://dashboard.emailjs.com/

# Your EmailJS Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Service ID (e.g., service_xxxxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID for store owner emails (e.g., template_xxxxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# (Optional) Your EmailJS Template ID for customer confirmation emails
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=your_customer_template_id_here

# Your store email address (where orders will be sent)
VITE_STORE_EMAIL=your_store_email@example.com
